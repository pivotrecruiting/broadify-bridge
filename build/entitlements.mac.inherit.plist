<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Inherited entitlements (electron-builder `mac.entitlementsInherit`).
    Applied to EVERY nested bundle in the packaged app, including Electron's
    own Helper (Renderer), Helper (GPU) and Helper (Plugin) processes as well
    as embedded apps (e.g. the bundled meeting helper).
    The renderer helper REQUIRES allow-jit / allow-unsigned-executable-memory
    under hardened runtime — without them V8 is killed on launch (white screen,
    render-process-gone exitCode=5). Do not strip these.
  -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <!--
      audio-input is required by the bundled meeting helper: electron-builder
      re-signs every nested bundle with THIS file (there is no runtime
      inheritance), so a key missing here is stripped from the helper even
      though its own entitlements file declares it. Guarded by the superset
      assertion in scripts/meeting-helper-release-contract.test.cjs.
    -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
